{
  "name": "sticky-note-cli",
  "version": "4.0.0-alpha.0",
  "description": "Shared memory for AI coding agents. Git-backed record of what every teammate's agent is doing and has done.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "sticky-note": "dist/cli.js",
    "sticky-note-cli": "dist/cli.js"
  },
  "files": [
    "dist/"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/cli/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsup": "^8.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BandaruDheeraj/sticky-note.git"
  }
