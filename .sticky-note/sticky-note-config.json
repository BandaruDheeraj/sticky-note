{
  "stale_days": 14,
  "inject_token_budget": 1000,
  "mcp_servers": [
    {
      "name": "sticky-note",
      "type": "stdio",
      "source": ".mcp.json",
      "command": "npx",
      "args": [
        "-y",
        "-p",
        "sticky-note-cli",
        "sticky-note",
        "mcp-server"
      ]
    },
    {
      "name": "context7",
      "type": "stdio",
      "source": ".mcp.json",
      "command": "npx",
      "args": [
        "-y",
        "@upstash/context7-mcp@latest"
      ]
    },
    {
      "name": "github",
      "type": "stdio",
      "source": ".mcp.json",
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-github"
      ],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_TOKEN}"
      }
    },
    {
      "name": "plugin_cloudflare_cloudflare-api",
      "source": "auto-detected"
    }
  ],
  "skills": [],
  "conventions": [],
  "hook_version": "3.1.5",
  "min_version": "3.1.5",
  "sticky_url": "https://sticky-note-server.sticky-server.workers.dev",
  "environment_version": "1"
}
