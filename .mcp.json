{
  "mcpServers": {
    "sticky-note": {
      "type": "stdio",
      "command": "node",
      "args": [
        ".claude/sticky-note-mcp.js"
      ]
    },
    "context7": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@upstash/context7-mcp@latest"
      ]
    },
    "github": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-github"
      ],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_TOKEN}"
      }
    },
    "claude_ai_Exa": {}
  }
}
